  quests:
  - id: 0
    name: "\u0412\u043E\u043E\u0440\u0443\u0436\u0430\u0435\u043C\u0441\u044F!"
    description: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043B\u044E\u0431\u043E\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435"
    exp: 100
    details: []
    state: 1
    typeOfQuest: 1
    questsToStart: 
    activationIds: 00000000
    startObjectId: 0
    startObjectsCount: 0
    collectedObjectId: 0
    collectedObjectsCount: 0
    targetEnemyId: 0
    targetEnemyCount: 0
  - id: 1
    name: "\u041D\u0430 \u043C\u043E\u0441\u0442\u0438\u043A"
    description: "\u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E
      \u043C\u043E\u0441\u0442\u0438\u043A\u0430"
    exp: 500
    details:
    - text: "\u041C\u043E\u0441\u0442\u0438\u043A \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u0432 \u043D\u043E\u0441\u043E\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u0421\u0442\u043E\u0438\u0442
        \u043B\u0438 \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F
        \u0441\u043E \u0432\u0441\u0435\u043C \u0434\u0440\u043E\u043D\u0430\u043C\u0438?
        \u041D\u0430 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0441\u043B\u0435\u0442\u044F\u0442\u0441\u044F
        \u0432\u0440\u0430\u0433\u0438 \u0441\u043E \u0432\u0441\u0435\u0433\u043E
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u041C\u043E\u0436\u0435\u0442,
        \u043B\u0443\u0447\u0448\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043B\u0430\u0437\u044B?"
      unblock: 1
      EXP: 0
    - text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043A\u0430\u043F\u0438\u0442\u0430\u043D
        \u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
        \u0443\u0436\u0435 \u043C\u0435\u0440\u0442\u0432\u044B. \u0412\u044B\u043F\u0443\u0442\u044B\u0432\u0430\u0442\u044C\u0441\u044F
        \u0431\u0443\u0434\u0435\u043C \u043D\u0430 \u043F\u0430\u0440\u0443 \u0441
        \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C \u0410\u0440\u043A\u0443\u0441\u043E\u043C."
      unblock: 0
      EXP: 0
    state: 0
    typeOfQuest: 1
    questsToStart: 00000000
    activationIds: 01000000
    startObjectId: 0
    startObjectsCount: 0
    collectedObjectId: 0
    collectedObjectsCount: 0
    targetEnemyId: 0
    targetEnemyCount: 0
  - id: 2
    name: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u043E\u0431\u0435\u0433"
    description: "\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0432\u0441\u0435
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
      \u043F\u043E\u0431\u0435\u0433 \u043E\u0442 \u0432\u0440\u0430\u0433\u0430"
    exp: 2000
    details:
    - text: "\u0412\u0441\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u044B\u0435
        \u0440\u0430\u0431\u043E\u0442\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u044B"
      unblock: 0
      EXP: 0
    - text: "\u0420\u0435\u0430\u043A\u0442\u043E\u0440 \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D"
      unblock: 0
      EXP: 0
    - text: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0434\u043B\u044F \u043F\u043E\u0431\u0435\u0433\u0430
        \u043F\u0440\u043E\u043B\u043E\u0436\u0435\u043D"
      unblock: 0
      EXP: 0
    state: 0
    typeOfQuest: 1
    questsToStart: 01000000
    activationIds: 020000000300000004000000
    startObjectId: 0
    startObjectsCount: 0
    collectedObjectId: 0
    collectedObjectsCount: 0
    targetEnemyId: 0
    targetEnemyCount: 0
  - id: 3
    name: "\u0420\u0435\u043C\u043E\u043D\u0442\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B"
    description: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438,
      \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u0438 \u0442\u043E\u043F\u043B\u0438\u0432\u043D\u0443\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u0443, \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0432
      \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u044B\u0445 \u0434\u0440\u043E\u043D\u043E\u0432"
    exp: 1000
    details:
    - text: "\u041C\u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
        \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0434\u0440\u043E\u043D\u043E\u0432
        \u0434\u043B\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0438 \u0441\u0438\u0441\u0442\u0435\u043C.
        \u041E\u0434\u0438\u043D \u043F\u043E\u0439\u0434\u0451\u0442 \u043F\u043E
        \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u043E\u0431\u0448\u0438\u0432\u043A\u0435
        \u0438 \u043F\u043E\u0447\u0438\u043D\u0438\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438
        \u0441\u043D\u0430\u0440\u0443\u0436\u0438. \u041E \u043D\u0451\u043C \u043C\u043E\u0436\u043D\u043E
        \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C\u0441\u044F.
        \u0410 \u0432\u043E\u0442 \u0434\u0443\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
        \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
        \u043F\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u043C \u0442\u0430\u043A,
        \u0447\u0442\u043E\u0431\u044B \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435
        \u0434\u0440\u043E\u043D\u044B \u0438\u0445 \u043D\u0435 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B\u0438.
        \u041F\u0435\u0440\u0435\u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
        \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043F\u0443\u0442\u0435\u0439
        \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0435\u0442."
      unblock: 1
      EXP: 0
    - text: "\u0414\u0440\u043E\u043D \u0434\u043B\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0438
        \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D.
        \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0432\u044B\u0436\u0434\u0430\u0442\u044C."
      unblock: 0
      EXP: 0
    - text: "\u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C \u043F\u043E\u0447\u0438\u043D\u0435\u043D.
        \u041C\u044B \u0441\u043C\u043E\u0436\u0435\u043C \u0443\u043B\u0435\u0442\u0435\u0442\u044C."
      unblock: 0
      EXP: 0
    - text: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u043F\u043E\u0447\u0438\u043D\u0435\u043D."
      unblock: 0
      EXP: 0
    - text: "\u0422\u043E\u043F\u043B\u0438\u0432\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
        \u043F\u043E\u0447\u0438\u043D\u0435\u043D\u0430. \u0412\u0440\u043E\u0434\u0435,
        \u0442\u043E\u043F\u043B\u0438\u0432\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
        \u0447\u0442\u043E\u0431\u044B \u043C\u044B \u0441\u043C\u043E\u0433\u043B\u0438
        \u043E\u0442\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F."
      unblock: 0
      EXP: 0
    state: 0
    typeOfQuest: 1
    questsToStart: 01000000
    activationIds: 050000000600000007000000
