  - id: 5
    name: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D"
    description: "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0443
      \u0410\u0440\u043A\u0443\u0441\u0443 \u043F\u0440\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u043C
      \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435."
    exp: 2000
    details:
    - text: "\u0410\u0440\u043A\u0443\u0441 \u043F\u0440\u043E\u0441\u0438\u0442
        \u043D\u0430\u0439\u0442\u0438 \u043F\u0430\u0440\u043E\u043B\u044C\u043D\u044B\u0435
        \u043A\u0430\u0440\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
        \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
        \u043A\u0430\u043F\u0438\u0442\u0430\u043D \u0438 \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
        \u0434\u043B\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u0430
        \u043A \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C \u043C\u043E\u0441\u0442\u0438\u043A\u0430.
        \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C, \u043D\u0430\u0439\u0442\u0438
        \u0442\u0435\u043B\u0430."
      unblock: 1
      EXP: 0
    - text: "\u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
        \u0431\u044B\u043B \u0443\u0431\u0438\u0442 \u043D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438
        \u043A \u043C\u043E\u0441\u0442\u0438\u043A\u0443. \u0416\u0430\u043B\u044C
        \u0435\u0433\u043E, \u043D\u043E \u043A\u0430\u0440\u0442\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u0430
        \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430."
      unblock: 0
      EXP: 0
    - text: "\u041A\u0430\u043F\u0438\u0442\u0430\u043D \u0431\u044B\u043B \u0443\u0431\u0438\u0442
        \u0443 \u0448\u043B\u044E\u0437\u0430, \u043A\u0430\u043A \u0438 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
        \u0441\u043B\u0443\u0436\u0431\u044B \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
        \u0422\u0435\u043B\u0430 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
        \u0443\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u0442\u043E\u043C. \u0421\u0435\u0439\u0447\u0430\u0441
        \u0433\u043B\u0430\u0432\u043D\u043E\u0435, \u0447\u0442\u043E \u0443\u0434\u0430\u043B\u043E\u0441\u044C
        \u043D\u0430\u0439\u0442\u0438 \u043A\u0430\u0440\u0442\u0443 \u0434\u043E\u0441\u0442\u0443\u043F\u0430."
      unblock: 0
      EXP: 0
