  - id: 4
    name: "\u0421\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u044F
      \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430"
    description: "\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u0437\u043E\u043D\u0443
      \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430 \u0438 \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435
      \u0432\u0441\u0435 4 \u044F\u0434\u0440\u0430."
    exp: 2000
    details:
    - text: "\u0412 \u0437\u043E\u043D\u0435 \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430
        \u043A\u0430\u0436\u0434\u043E\u0435 \u044F\u0434\u0440\u043E \u0442\u0435\u043F\u0435\u0440\u044C
        \u0438\u043C\u0435\u0435\u0442 \u043A\u043D\u043E\u043F\u043A\u0443 \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438.
        \u041F\u0440\u0430\u0432\u0434\u0430, \u043E\u0434\u043D\u0430 \u0438\u0437
        \u043D\u0438\u0445 \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u0430.
        \u0410\u0440\u043A\u0443\u0441 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
        \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
        \u0435\u0433\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E. \u041F\u043E\u0445\u043E\u0436\u0435,
        \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043B\u0430\u0437\u043E\u043C. "
      unblock: 0
      EXP: 0
    state: 0
    typeOfQuest: 1
    questsToStart: 01000000
    activationIds: 08000000090000000a0000000b000000
